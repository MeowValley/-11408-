{
  "id": "DS-07-02",
  "title": "冒泡排序（Bubble Sort）",
  "intuition_text": "想象一排水里的气泡：大的气泡总是会<b>先浮到水面</b>。冒泡排序也一样——每一轮把当前<b>最大的元素「冒」到最后面</b>，就像气泡上浮。",
  "code": [
    { "txt": "for j in 0..n-2:", "tip": "外层循环：第 j 趟" },
    { "txt": "  swapped = false", "tip": "本趟是否发生交换的标志" },
    { "txt": "  for i in 0..n-2-j:", "tip": "内层循环：每趟少比一个" },
    { "txt": "    if a[i] > a[i+1]:", "tip": "相邻元素比较" },
    { "txt": "      swap(a[i], a[i+1])", "tip": "逆序则交换" },
    { "txt": "      swapped = true", "tip": "记录发生了交换" },
    { "txt": "  if not swapped: break", "tip": "本趟无交换，提前结束" }
  ],
  "steps": [
    { "code_line_idx": 0, "visual_state": { "arr": [5, 3, 8, 1, 9] }, "subtitle": "初始数组 [5,3,8,1,9]" },
    { "code_line_idx": 3, "visual_state": { "arr": [5, 3, 8, 1, 9], "highlight": [0, 1] }, "subtitle": "比较 a[0]=5 与 a[1]=3" },
    { "code_line_idx": 4, "visual_state": { "arr": [3, 5, 8, 1, 9], "swapped": [0, 1] }, "subtitle": "5 > 3，交换 → [3,5,8,1,9]" },
    { "code_line_idx": 3, "visual_state": { "arr": [3, 5, 8, 1, 9], "highlight": [1, 2] }, "subtitle": "比较 a[1]=5 与 a[2]=8" },
    { "code_line_idx": 3, "visual_state": { "arr": [3, 5, 8, 1, 9], "highlight": [2, 3] }, "subtitle": "比较 a[2]=8 与 a[3]=1" },
    { "code_line_idx": 4, "visual_state": { "arr": [3, 5, 1, 8, 9], "swapped": [2, 3] }, "subtitle": "8 > 1，交换 → [3,5,1,8,9]" },
    { "code_line_idx": 3, "visual_state": { "arr": [3, 5, 1, 8, 9], "highlight": [3, 4] }, "subtitle": "比较 a[3]=8 与 a[4]=9" },
    { "code_line_idx": 6, "visual_state": { "arr": [3, 5, 1, 8, 9], "sorted": [4] }, "subtitle": "第一趟结束，最大值 9 已冒泡到末尾" },
    { "code_line_idx": 0, "visual_state": { "arr": [3, 1, 5, 8, 9], "sorted": [3, 4] }, "subtitle": "第二趟结束，8 冒泡到位 → [3,1,5,8,9]" },
    { "code_line_idx": 6, "visual_state": { "arr": [1, 3, 5, 8, 9], "sorted": [0, 1, 2, 3, 4] }, "subtitle": "排序完成 → [1,3,5,8,9]" }
  ],
  "derivation": [
    "\\text{比较次数 } C = \\sum_{j=0}^{n-2}(n-1-j)",
    "= (n-1)+(n-2)+\\cdots+1",
    "= \\dfrac{n(n-1)}{2}",
    "\\Rightarrow T(n) = O(n^2)"
  ],
  "exam_text": "对序列 5, 3, 8, 1, 9 进行一趟冒泡排序后，序列变为？",
  "exam_answer": "答案：3, 5, 1, 8, 9 —— 最大元素 9 已「冒」到末尾。",
  "pitfall_list": [
    "内层循环结束条件写成 i < n 会导致越界——应为 i < n - 1 - j。",
    "每趟比较次数是 n-1-j，不是固定 n-1（已排好尾部的不用再比）。",
    "优化版用 swapped 标志提前结束，别漏掉这一最优性判断。"
  ],
  "quiz_list": [
    {
      "question": "冒泡排序的最坏时间复杂度是？",
      "options": ["O(n²)", "O(n log n)", "O(n)"],
      "correct": 0
    },
    {
      "question": "最好情况（已有序）下，优化版冒泡排序的时间复杂度是？",
      "options": ["O(n)", "O(n²)", "O(log n)"],
      "correct": 0
    }
  ]
}
